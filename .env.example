# Copy this file to .env. The default Compose path uses independent REST/MCP static-bearer secrets.
# For oauth-jwt MCP migration, leave the MCP token/subject empty and use the public profile settings below.
ZAPTRACE_API_TOKEN=
ZAPTRACE_MCP_HTTP_TOKEN=

# Host ports remain bound to 127.0.0.1 by docker-compose.yml.
ZAPTRACE_API_PUBLISHED_PORT=8000
ZAPTRACE_MCP_HTTP_PUBLISHED_PORT=8090

# Optional server-controlled identity and capability policy.
ZAPTRACE_API_TOKEN_SUBJECT=compose-api
ZAPTRACE_API_TOKEN_SCOPES=read
ZAPTRACE_API_TOKEN_SESSIONS=*
ZAPTRACE_MCP_TOKEN_SUBJECT=compose-mcp

# MCP tool discovery surface. expert preserves all tools; reduced surfaces narrow tools/list only.
# Supported reduced values: inspect|design|verify|repair|release
ZAPTRACE_MCP_TOOL_SURFACE=expert

# Optional versioned MCP HTTP profile selection.
# Keep these unset to preserve the 0.3.x legacy inference behavior above.
# ZAPTRACE_MCP_AUTH_CONFIG_VERSION=1
# ZAPTRACE_MCP_AUTH_PROFILE=static-bearer
# ZAPTRACE_MCP_AUTH_PROFILE=oauth-jwt

# The oauth-jwt URLs below are public configuration placeholders, not secrets.
# When selecting oauth-jwt, leave ZAPTRACE_MCP_HTTP_TOKEN and ZAPTRACE_MCP_TOKEN_SUBJECT empty.
# Access tokens, authorization-server credentials, and signing material stay outside this file/repository.
# ZAPTRACE_MCP_PUBLIC_BASE_URL=https://mcp.example.com
# ZAPTRACE_MCP_AUTH_RESOURCE_URI=https://mcp.example.com/mcp
# ZAPTRACE_MCP_AUTHORIZATION_SERVER=https://auth.example.com/
# ZAPTRACE_MCP_AUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
