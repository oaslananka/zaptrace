{
  "$defs": {
    "AgentEvaluationArtifact": {
      "description": "One generated scenario artifact and its content identity.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "produced_by_step": {
          "default": "",
          "title": "Produced By Step",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "kind",
        "sha256",
        "size_bytes"
      ],
      "title": "AgentEvaluationArtifact",
      "type": "object"
    },
    "AgentEvaluationBenchmarkLink": {
      "description": "Link from an evaluation scenario to benchmark/scorecard evidence.",
      "properties": {
        "board_family_id": {
          "default": "",
          "title": "Board Family Id",
          "type": "string"
        },
        "grade": {
          "default": "",
          "title": "Grade",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "scorecard_sha256": {
          "default": "",
          "title": "Scorecard Sha256",
          "type": "string"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "step_id"
      ],
      "title": "AgentEvaluationBenchmarkLink",
      "type": "object"
    },
    "AgentEvaluationCallDisposition": {
      "description": "Why one surface-aware agent call executed, stopped, or was denied.",
      "enum": [
        "executed",
        "invalid-surface-call",
        "expected-policy-denial",
        "unexpected-policy-denial",
        "authorization-expectation-mismatch",
        "runtime-failure"
      ],
      "title": "AgentEvaluationCallDisposition",
      "type": "string"
    },
    "AgentEvaluationExecutor": {
      "description": "Execution surface for one scenario step.",
      "enum": [
        "agent-tool",
        "synthesis-proof",
        "engine-benchmark"
      ],
      "title": "AgentEvaluationExecutor",
      "type": "string"
    },
    "AgentEvaluationMode": {
      "description": "Supported harness execution modes.",
      "enum": [
        "ci",
        "nightly"
      ],
      "title": "AgentEvaluationMode",
      "type": "string"
    },
    "AgentEvaluationOutcome": {
      "description": "Supported scenario outcomes.",
      "enum": [
        "success",
        "blocked",
        "human-review-required",
        "stop-condition"
      ],
      "title": "AgentEvaluationOutcome",
      "type": "string"
    },
    "AgentEvaluationProofLink": {
      "description": "Link from an evaluation scenario to proof-pack evidence.",
      "properties": {
        "autonomous_status": {
          "default": "",
          "title": "Autonomous Status",
          "type": "string"
        },
        "manifest_path": {
          "default": "",
          "title": "Manifest Path",
          "type": "string"
        },
        "manifest_sha256": {
          "default": "",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "report_path": {
          "default": "",
          "title": "Report Path",
          "type": "string"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "step_id"
      ],
      "title": "AgentEvaluationProofLink",
      "type": "object"
    },
    "AgentEvaluationRiskClass": {
      "description": "Risk carried by one evaluation project brief.",
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ],
      "title": "AgentEvaluationRiskClass",
      "type": "string"
    },
    "AgentEvaluationScenarioResult": {
      "description": "Auditable result for one scenario.",
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/AgentEvaluationArtifact"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "benchmark_links": {
          "items": {
            "$ref": "#/$defs/AgentEvaluationBenchmarkLink"
          },
          "title": "Benchmark Links",
          "type": "array"
        },
        "expected_outcome": {
          "$ref": "#/$defs/AgentEvaluationOutcome"
        },
        "failure_count": {
          "minimum": 0,
          "title": "Failure Count",
          "type": "integer"
        },
        "matched_expectation": {
          "title": "Matched Expectation",
          "type": "boolean"
        },
        "non_claims": {
          "items": {
            "type": "string"
          },
          "title": "Non Claims",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/AgentEvaluationOutcome"
        },
        "proof_links": {
          "items": {
            "$ref": "#/$defs/AgentEvaluationProofLink"
          },
          "title": "Proof Links",
          "type": "array"
        },
        "replay_digest": {
          "default": "",
          "title": "Replay Digest",
          "type": "string"
        },
        "replay_equivalent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replay Equivalent"
        },
        "replay_trace_sha256": {
          "default": "",
          "title": "Replay Trace Sha256",
          "type": "string"
        },
        "risk_class": {
          "$ref": "#/$defs/AgentEvaluationRiskClass"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "stop_reason": {
          "title": "Stop Reason",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "tool_call_count": {
          "minimum": 0,
          "title": "Tool Call Count",
          "type": "integer"
        },
        "total_duration_ms": {
          "default": 0.0,
          "minimum": 0,
          "title": "Total Duration Ms",
          "type": "number"
        },
        "trace_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trace Sha256",
          "type": "string"
        },
        "traces": {
          "items": {
            "$ref": "#/$defs/AgentEvaluationTraceEntry"
          },
          "title": "Traces",
          "type": "array"
        }
      },
      "required": [
        "scenario_id",
        "title",
        "risk_class",
        "expected_outcome",
        "outcome",
        "matched_expectation",
        "stop_reason",
        "session_id",
        "tool_call_count",
        "failure_count",
        "trace_sha256",
        "traces",
        "artifacts"
      ],
      "title": "AgentEvaluationScenarioResult",
      "type": "object"
    },
    "AgentEvaluationStepStatus": {
      "description": "Observed status of one execution step.",
      "enum": [
        "passed",
        "failed",
        "stopped"
      ],
      "title": "AgentEvaluationStepStatus",
      "type": "string"
    },
    "AgentEvaluationSurfaceMetrics": {
      "description": "Aggregate deterministic call and task evidence for one reduced MCP surface.",
      "properties": {
        "authorization_denial_count": {
          "minimum": 0,
          "title": "Authorization Denial Count",
          "type": "integer"
        },
        "authorization_denial_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Authorization Denial Rate",
          "type": "number"
        },
        "authorization_expectation_mismatch_count": {
          "minimum": 0,
          "title": "Authorization Expectation Mismatch Count",
          "type": "integer"
        },
        "expected_policy_denial_count": {
          "minimum": 0,
          "title": "Expected Policy Denial Count",
          "type": "integer"
        },
        "invalid_call_count": {
          "minimum": 0,
          "title": "Invalid Call Count",
          "type": "integer"
        },
        "invalid_call_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Invalid Call Rate",
          "type": "number"
        },
        "planned_call_count": {
          "minimum": 0,
          "title": "Planned Call Count",
          "type": "integer"
        },
        "replay_check_count": {
          "minimum": 0,
          "title": "Replay Check Count",
          "type": "integer"
        },
        "replay_equivalence_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Replay Equivalence Rate",
          "type": "number"
        },
        "replay_equivalent_count": {
          "minimum": 0,
          "title": "Replay Equivalent Count",
          "type": "integer"
        },
        "replay_mismatch_count": {
          "minimum": 0,
          "title": "Replay Mismatch Count",
          "type": "integer"
        },
        "runtime_failure_count": {
          "minimum": 0,
          "title": "Runtime Failure Count",
          "type": "integer"
        },
        "surface": {
          "title": "Surface",
          "type": "string"
        },
        "task_completion_count": {
          "minimum": 0,
          "title": "Task Completion Count",
          "type": "integer"
        },
        "task_completion_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Task Completion Rate",
          "type": "number"
        },
        "task_count": {
          "minimum": 0,
          "title": "Task Count",
          "type": "integer"
        },
        "task_outcome_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Task Outcome Counts",
          "type": "object"
        },
        "tool_contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tool Contract Sha256",
          "type": "string"
        },
        "unexpected_policy_denial_count": {
          "minimum": 0,
          "title": "Unexpected Policy Denial Count",
          "type": "integer"
        },
        "visible_tool_count": {
          "minimum": 0,
          "title": "Visible Tool Count",
          "type": "integer"
        }
      },
      "required": [
        "surface",
        "visible_tool_count",
        "tool_contract_sha256",
        "planned_call_count",
        "invalid_call_count",
        "invalid_call_rate",
        "authorization_denial_count",
        "authorization_denial_rate",
        "expected_policy_denial_count",
        "unexpected_policy_denial_count",
        "authorization_expectation_mismatch_count",
        "runtime_failure_count",
        "task_count",
        "task_completion_count",
        "task_completion_rate",
        "task_outcome_counts",
        "replay_check_count",
        "replay_equivalent_count",
        "replay_mismatch_count",
        "replay_equivalence_rate"
      ],
      "title": "AgentEvaluationSurfaceMetrics",
      "type": "object"
    },
    "AgentEvaluationTraceEntry": {
      "description": "Normalized audit record for one harness step.",
      "properties": {
        "artifact_paths": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Paths",
          "type": "array"
        },
        "authorization_reason": {
          "default": "",
          "title": "Authorization Reason",
          "type": "string"
        },
        "call_number": {
          "minimum": 1,
          "title": "Call Number",
          "type": "integer"
        },
        "disposition": {
          "$ref": "#/$defs/AgentEvaluationCallDisposition",
          "default": "executed"
        },
        "duration_ms": {
          "default": 0.0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "error_message": {
          "default": "",
          "title": "Error Message",
          "type": "string"
        },
        "error_type": {
          "default": "",
          "title": "Error Type",
          "type": "string"
        },
        "executor": {
          "$ref": "#/$defs/AgentEvaluationExecutor"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "params_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Params Sha256",
          "type": "string"
        },
        "required_capability": {
          "default": "",
          "title": "Required Capability",
          "type": "string"
        },
        "result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Sha256",
          "type": "string"
        },
        "risk": {
          "default": "safe",
          "title": "Risk",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AgentEvaluationStepStatus"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "surface": {
          "default": "",
          "title": "Surface",
          "type": "string"
        },
        "timestamp": {
          "default": 0.0,
          "minimum": 0,
          "title": "Timestamp",
          "type": "number"
        }
      },
      "required": [
        "call_number",
        "step_id",
        "executor",
        "operation",
        "status",
        "params_sha256",
        "result_sha256"
      ],
      "title": "AgentEvaluationTraceEntry",
      "type": "object"
    }
  },
  "description": "Top-level CI/nightly agent evaluation evidence.",
  "properties": {
    "corpus_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Corpus Sha256",
      "type": "string"
    },
    "corpus_version": {
      "title": "Corpus Version",
      "type": "string"
    },
    "evidence_identity": {
      "additionalProperties": true,
      "title": "Evidence Identity",
      "type": "object"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "harness_version": {
      "default": "1.0",
      "title": "Harness Version",
      "type": "string"
    },
    "mismatch_count": {
      "minimum": 0,
      "title": "Mismatch Count",
      "type": "integer"
    },
    "mode": {
      "$ref": "#/$defs/AgentEvaluationMode"
    },
    "non_claims": {
      "items": {
        "type": "string"
      },
      "title": "Non Claims",
      "type": "array"
    },
    "outcome_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Outcome Counts",
      "type": "object"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "protocol_version": {
      "default": "2026-07-28",
      "title": "Protocol Version",
      "type": "string"
    },
    "report_sha256": {
      "default": "",
      "title": "Report Sha256",
      "type": "string"
    },
    "scenario_count": {
      "minimum": 0,
      "title": "Scenario Count",
      "type": "integer"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/AgentEvaluationScenarioResult"
      },
      "title": "Scenarios",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "surface_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Surface Contract Sha256",
      "type": "string"
    },
    "surface_metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/AgentEvaluationSurfaceMetrics"
      },
      "title": "Surface Metrics",
      "type": "object"
    },
    "surface_regression_count": {
      "default": 0,
      "minimum": 0,
      "title": "Surface Regression Count",
      "type": "integer"
    }
  },
  "required": [
    "corpus_version",
    "corpus_sha256",
    "surface_contract_sha256",
    "mode",
    "generated_at",
    "passed",
    "scenario_count",
    "mismatch_count",
    "outcome_counts",
    "scenarios"
  ],
  "title": "AgentEvaluationReport",
  "type": "object"
}
