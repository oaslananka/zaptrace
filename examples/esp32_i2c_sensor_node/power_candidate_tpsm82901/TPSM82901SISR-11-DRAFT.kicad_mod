  (fp_rect (start -1.5 -1.4) (end 1.5 1.4) (stroke (width 0.05) (type default)) (fill none) (layer "F.Fab"))
  (fp_rect (start -1.8 -1.7) (end 1.8 1.7) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
  (fp_line (start -1.5 -1.4) (end 1.5 -1.4) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
