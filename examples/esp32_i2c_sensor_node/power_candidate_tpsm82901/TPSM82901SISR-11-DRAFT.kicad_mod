  (fp_line (start 1.5 -1.4) (end 1.5 1.4) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
  ; TI SIS0011A land-pattern example: solder-mask-defined perimeter lands.
  ; Endpoint pads are larger; six interior pads use 0.25 mm width.
  (pad "1" smd rect (at -1.075 -1.1625) (size 0.55 0.575) (solder_mask_margin -0.05) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "2" smd rect (at -1.075 -0.5) (size 0.55 0.25) (solder_mask_margin -0.05) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "3" smd rect (at -1.075 0) (size 0.55 0.25) (solder_mask_margin -0.05) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "4" smd rect (at -1.075 0.5) (size 0.55 0.25) (solder_mask_margin -0.05) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "5" smd rect (at -1.075 1.1625) (size 0.55 0.575) (solder_mask_margin -0.05) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "10" smd rect (at 1.075 -1.1625) (size 0.55 0.575) (solder_mask_margin -0.05) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "9" smd rect (at 1.075 -0.5) (size 0.55 0.25) (solder_mask_margin -0.05) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "8" smd rect (at 1.075 0) (size 0.55 0.25) (solder_mask_margin -0.05) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "7" smd rect (at 1.075 0.5) (size 0.55 0.25) (solder_mask_margin -0.05) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "6" smd rect (at 1.075 1.1625) (size 0.55 0.575) (solder_mask_margin -0.05) (layers "F.Cu" "F.Paste" "F.Mask"))
  ; Exposed thermal land, solder-mask-defined. Two paste windows give ~80%
  ; nominal stencil coverage; three 0.20 mm drilled thermal vias are optional
  ; per TI, but must be filled/plugged/tented when placed under paste.
  (pad "11" smd rect (at 0 0) (size 0.9 2.15) (solder_mask_margin -0.05) (solder_paste_margin 0) (layers "F.Cu" "F.Mask"))
  ; Two paste windows are a local 80% area approximation of TI's split stencil.
  (fp_rect (start -0.4 -1.06) (end 0.4 -0.09) (stroke (width 0) (type solid)) (fill solid) (layer "F.Paste"))
  (fp_rect (start -0.4 0.09) (end 0.4 1.06) (stroke (width 0) (type solid)) (fill solid) (layer "F.Paste"))
