# Auto-detect text files and normalize line endings to LF in git repository
* text=auto eol=lf

# Explicit source code and configuration assets forced to LF
*.py text eol=lf
*.rs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.kicad_pcb text eol=lf
*.kicad_sch text eol=lf
*.kicad_mod text eol=lf
*.kicad_pro text eol=lf
*.SchDoc text eol=lf
*.epro text eol=lf
*.brd text eol=lf
*.asc text eol=lf
*.svg text eol=lf
*.lock text eol=lf

# Binary files that must remain un-translated
*.bin -text
*.so -text
*.rlib -text
*.rmeta -text
*.o -text
*.pyc -text
*.png -text
*.jpg -text
*.jpeg -text
*.pdf -text
*.zip -text
*.step -text
*.stp -text
